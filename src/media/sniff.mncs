mncs 0.18;

// mncs.media.sniff.v1 — container/codec sniffing over fixed header windows.
//
// Magic-byte identification is total pattern matching over explicit
// bytes, never prose parsing. The PNG signature is 8 bytes
// (137 80 78 71 13 10 26 10); all eight lanes participate so a
// truncated or wrong-magic header is `Unknown`, not a trap and not a
// guess. Longer container parsing belongs to backends.

module mncs.media.sniff.v1;

enum Sniff { Png, Unknown }

fn sniff8(bytes: [byte; 8]) -> (result: Sniff) {
    if bytes[0] as u64 == 137 && bytes[1] as u64 == 80 && bytes[2] as u64 == 78 && bytes[3] as u64 == 71 {
        return sniff_png_tail(bytes);
    }
    return Sniff.Unknown;
}

fn sniff_png_tail(bytes: [byte; 8]) -> (result: Sniff) {
    if bytes[4] as u64 == 13 && bytes[5] as u64 == 10 && bytes[6] as u64 == 26 && bytes[7] as u64 == 10 {
        return Sniff.Png;
    }
    return Sniff.Unknown;
}

fn sniff_is_png(s: Sniff) -> (result: bool) {
    return match s {
        Sniff.Png => true,
        Sniff.Unknown => false,
    };
}
